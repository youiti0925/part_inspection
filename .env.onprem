# =============================================================================
# 社内サーバ版のビルド(npm run build:onprem = vite build --mode onprem)の設定 — 2026-10-29
# -----------------------------------------------------------------------------
# ⚠ このファイルは git に入れる(秘密を書かない。VITE_ の値は JS へ焼き込まれる)。
# ⚠ .env / .env.local より優先される(Vite の決まり: .env.[mode] が勝つ)。
#   だから外の Worker の URL(.env の VITE_DRIVE_PROXY_URL など)は、ここで空にして社内版へ入れない。
# ⚠ PocketBase の行き先と端末用アカウントは、ビルドした dist-onprem の index.html の横に置く
#   onprem-config.json に書く(見本: docs/onprem-config.example.json)。ビルドし直さずに変えられる。
# =============================================================================
VITE_ONPREM=1

# 設定ファイルに url が無い時だけ使う行き先(空でよい)。
VITE_PB_URL=

# 外(インターネット)の Worker。ビルドには焼き込まない(空)。
# 2026-10-30: AI の中継は onprem-config.json の aiProxyUrl に書けば使える(ビルドし直さない)。書かなければ「未設定」と出して止まる(落ちない)。
# 通知の中継(Worker URL)は今まで通り 連絡タブの設定(settings.push)に書く。
VITE_DRIVE_PROXY_URL=
VITE_GEMINI_PROXY_URL=

# 開発用のエミュレータは社内版のビルドでは使わない
VITE_USE_EMULATOR=
