{
  "name": "parts-inspection-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "deploy-safety": "node scripts/selftest-deploy-safety.mjs && node scripts/verify-deploy-safety.mjs",
    "attic-guard": "node scripts/selftest-keep-old-assets.mjs",
    "version-watch": "node scripts/selftest-version-watch.mjs && node scripts/verify-version-watch.mjs",
    "reload-gate": "node scripts/verify-reload-gate.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/domain/**/*.test.mjs\" \"src/data/**/*.test.mjs\"",
    "watchdogs-read-code": "node scripts/verify-watchdogs-read-code.mjs",
    "save-safety": "node scripts/selftest-save-safety.mjs && node scripts/verify-save-safety.mjs",
    "check": "node scripts/check-all.mjs",
    "check:bail": "node scripts/check-all.mjs --bail",
    "load-guards": "node scripts/check-load-guards.mjs",
    "worktime-guard": "node scripts/verify-worktime-guard.mjs",
    "jsx-undefined": "node scripts/check-jsx-undefined.mjs",
    "lint-baseline": "node scripts/selftest-lint-baseline.mjs && node scripts/verify-lint-baseline.mjs",
    "lint-baseline:update": "node scripts/verify-lint-baseline.mjs --update",
    "bare-disable": "node scripts/selftest-bare-eslint-disable.mjs && node scripts/verify-bare-eslint-disable.mjs",
    "bare-disable:update": "node scripts/verify-bare-eslint-disable.mjs --update",
    "read-budget-gate": "node scripts/verify-read-budget.mjs",
    "no-browser-key": "node scripts/verify-no-browser-api-key.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.10.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "glob-slasher": "^1.0.1",
    "globals": "^17.4.0",
    "minimatch": "^3.1.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.0"
  }
}
