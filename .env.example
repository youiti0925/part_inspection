# =============================================================================
# 部品検査アプリ の環境変数の見本
# -----------------------------------------------------------------------------
# 🚨🚨 いちばん大事な決まり:
#   `VITE_` で始まる値は **ビルドで公開バンドル(JS)へそのまま焼き込まれます**。
#   焼き込まれた JS は Hosting から全世界へ配られます。
#   → **秘密(APIキー・合言葉・token)を VITE_ に書かないでください。**
#     2026-07 に、これで Gemini の鍵が漏れました。
#     秘密は Cloudflare Worker の secret に置き、ブラウザは Worker の口を呼びます。
#   ⚠ この決まりは scripts/verify-no-browser-api-key.mjs が毎回見張っています。
#
# ⚠ このファイル(.env.example)だけが git に入ります。`.env` と `.env.*` は入りません。
#   別の端末で出す時は、**この見本を見て `.env` を手で作ってください**。
#   設定後: npm run deploy（🚨 npx firebase deploy を直に叩かない＝門を通らない裏口）
# =============================================================================

# --- AI (作業順の提案・深掘り分析・説明文の下書き) ---------------------------
# Cloudflare Worker の URL。**URL は秘密ではない**ので VITE_ でよい。
# 鍵(GEMINI_API_KEY)は Worker 側の secret にだけ置く事。
# 未設定なら AI のボタンは押せず、「AIサーバー未設定」と画面に出ます(黙って壊れません)。
VITE_GEMINI_PROXY_URL=https://gemini-proxy.あなたのサブドメイン.workers.dev

# --- Google Drive の資料フォルダ連動 -----------------------------------------
# 最終検査の gemini-proxy と同じ Worker。
# golden-meteoroid/worker/README_セットアップ手順.md の「Google Drive 資料フォルダ」参照。
VITE_DRIVE_PROXY_URL=https://gemini-proxy.あなたのサブドメイン.workers.dev

# =============================================================================
# 🧪 ここから下は **開発時だけ** の設定です(.env.local に書きます)。
#    本番ビルドでは import.meta.env.DEV が false なので、1つも効きません。
# -----------------------------------------------------------------------------
# 🚨🚨🚨 2026-08-28: 開発サーバが【本番 Firestore】に繋がっていて、
#    試しの操作が本番のロットへ書き込まれました。
#    2026-08-24 には「港の番号が設定に無いと **空の 8080** へ繋ぎ、
#    実データは 8380 に居るのに気づけない」も踏んでいます。
#    → いまは **繋ぎ先を必ずブラウザのコンソールに出します**。
#      VITE_USE_EMULATOR が 1 でなければ「本番に繋ごうとしています」と大きく出ます。
#    ⚠ 設定ファイルが在る事は証明になりません。実際の通信先は
#      node C:/Users/anrw3/inspection-audit-local/_conn_check.mjs <URL> で確かめてください。
#    ⚠ .env.local を足したり消したりすると、走っている開発サーバは繋ぎ先を作り直します。
#      消したら開発サーバも止めてください。
# =============================================================================

# 1 のときだけエミュレータへ繋ぎます。これ以外(空・0・未設定)は【本番】です。
VITE_USE_EMULATOR=1

# エミュレータの居場所。空なら既定(127.0.0.1 / 8080 / 9099)を使います。
# ⚠ 変数名は最終検査(golden = VITE_EMULATOR_PORT)と **揃っていません**。
#   部品検査は Firestore と Auth を別々に指せるようにしてあります。
#   揃えるなら4アプリ一度に直してください(片方だけ直すと必ずズレます)。
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_PORT=9099
